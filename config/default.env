# Home CCTV System - Configuración
# Copia este archivo como .env y edita los valores

# Puerto del servidor
PORT=3000

# Clave de acceso (cambia esto por algo seguro)
ACCESS_KEY=homecctv2024

# Sensibilidad de detección de movimiento (1-100)
MOTION_SENSITIVITY=30

# Intervalo de grabación en segundos (cuando hay movimiento)
RECORD_INTERVAL=10

# Carpeta de grabaciones
RECORDINGS_DIR=./recordings

# Habilitar acceso externo (ngrok o port forwarding)
ENABLE_REMOTE_ACCESS=false

# Token de ngrok (si usas ngrok para acceso externo)
NGROK_TOKEN=

# Notificaciones por email (opcional)
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
